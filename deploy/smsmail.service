[Unit]
Description=SmsMail 短信邮差（短信转发到邮箱）
Documentation=https://github.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smsmail
Group=smsmail
WorkingDirectory=/opt/smsmail
ExecStart=__NODE_BIN__ /opt/smsmail/server.js
Environment=NODE_ENV=production
Environment=SMSMAIL_CONFIG=/opt/smsmail/config.json
Environment=SMSMAIL_DATA=/opt/smsmail/data
Restart=always
RestartSec=3
LimitNOFILE=65535

# 只允许写自己的目录
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/smsmail

[Install]
WantedBy=multi-user.target
